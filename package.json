{
  "name": "bead-pattern-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run && node --test scripts/smoke-production.test.mjs",
    "verify": "npm run test:run && npm run typecheck && npm run lint && npm run build",
    "audit:prod": "npm audit --registry=https://registry.npmjs.org --omit=dev",
    "audit:all": "npm audit --registry=https://registry.npmjs.org --include=dev",
    "predeploy": "npm run verify && npm run audit:all && node scripts/predeploy-local.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "smoke:editor-mobile": "node scripts/smoke-editor-mobile.mjs"
  },
  "dependencies": {
    "canvas2svg": "^1.0.16",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.8.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
