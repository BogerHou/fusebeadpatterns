{
  "manifest_version": 3,
  "name": "Perler Bead Pattern Maker — Bead Capture",
  "description": "Turn an image into a bead pattern locally. Crop, choose Perler, Hama or Artkal S colors, and export or keep editing.",
  "version": "0.2.7",
  "minimum_chrome_version": "123",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["contextMenus", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Make a bead pattern", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{
    "matches": [
      "https://fusebeadpatterns.art/editor*",
      "https://fusebeadpatterns.art/de/editor*",
      "https://fusebeadpatterns.art/fr/editor*",
      "https://fusebeadpatterns.art/ja/editor*"
    ],
    "js": ["website-bridge.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
